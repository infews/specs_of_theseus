#!/usr/bin/env ruby
# frozen_string_literal: true

# Splits the overview into one diagram per stage, then renders every
# docs/src/*.mmd to docs/img/<same name>.svg with pele-laka export (which also
# writes a PNG when Google Chrome is installed). Any arguments are passed
# through to pele-laka export.
#
# Override the renderer with PELE=/path/to/pele-laka and the stylesheet
# with PELE_CSS=/path/to/style.css.
#
# Needs Ruby 4 (see .ruby-version). Where chruby doesn't load — CI, editor
# tasks, non-interactive shells — run: chruby-exec ruby-4.0 -- bin/build-diagrams

root = File.expand_path("..", __dir__)
pele = ENV.fetch("PELE", File.join(root, "../pele_preview/bin/pele-laka"))
css = ENV.fetch("PELE_CSS", File.join(File.dirname(pele), "../pele-noto.css"))
src = File.join(root, "docs/src")
img = File.join(root, "docs/img")

def run(*command)
  system(*command) or abort "build-diagrams: failed: #{command.join(' ')}"
end

# The stage diagrams are generated: edit the overview, not them.
run RbConfig.ruby, File.join(__dir__, "split-diagram"), File.join(src, "0_specs_of_theseus.mmd"), src,
    "--prefix", "theseus_", "--order", "Prod,UE,RS,Dev,Acceptance"

Dir[File.join(src, "*.mmd")].sort.each do |diagram|
  run pele, "export", "--css", css, "--output", img, *ARGV, diagram
end
